{
  "name": "bot-ndi",
  "version": "2.0.0",
  "description": "Isolated Threads automation service for Nusa Data Indonesia",
  "main": "src/index.js",
  "bin": {
    "bot-ndi": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js server",
    "migrate": "node src/cli.js migrate",
    "admin:create": "node src/cli.js admin:create",
    "dispatch": "node src/cli.js dispatch",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --test test/database.integration.test.js test/server.test.js test/dispatcher.test.js test/webhook.test.js && node --test test/configuration.mysql.js",
    "test:ndi:browser": "node --test e2e/ndi.browser.e2e.js",
    "lint": "eslint src scripts public",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}

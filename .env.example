# Runtime template for /opt/bot-ndi/.env. Copy this file on the LXC and chmod 600 it.
# Set HOST_IP only after verifying the current address assigned to the ndi-bot LXC.
NODE_ENV=production
PORT=3000
HOST_IP=
HOST_PORT=3000
BASE_URL=https://botndi.sequein.my.id
TIMEZONE=Asia/Jakarta
# Set only after NDI approves the marketing destination hostname(s); the app's domain is not assumed.
APPROVED_CTA_HOSTS=
# Keep false until the Traefik source address is verified, then set that exact address.
TRUST_PROXY=false

# Fresh, Bot NDI-only MySQL database. Generate new values on the LXC; do not reuse other apps' credentials.
DB_HOST=db
DB_PORT=3306
DB_NAME=bot_ndi
DB_USER=bot_ndi_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_POOL_SIZE=5

# Integration credentials may be preconfigured for NDI. This switch keeps all provider requests disabled until explicit approval.
TEBAR_API_KEY=
TEBAR_PROFILE_ID=
TEBAR_ACCOUNT_ID=
TEBAR_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_GENERATOR_TEMPERATURE=
OPENROUTER_GENERATOR_TOP_P=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# External API requests remain blocked during initial deployment and until NDI explicitly approves activation.
EXTERNAL_INTEGRATIONS_ENABLED=false
# Fresh deployments remain paused until integrations are configured and explicitly activated.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
LEARNING_CAPTURE_ENABLED=false
LEARNING_ACTIVATION_ENABLED=false
LEARNING_RETRIEVAL_ENABLED=false
LEARNING_PROMPT_INTEGRATION_ENABLED=false
LEARNING_SHADOW_ENABLED=false
LEARNING_RETENTION_ENABLED=false
LEARNING_RETENTION_DAYS=
